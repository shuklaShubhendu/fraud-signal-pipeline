# ─── Kafka / Redpanda ───
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_DEAD_LETTER=dead-letter
KAFKA_CONSUMER_GROUP=fraud-consumer-group

# ─── PostgreSQL ───
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline_secret@postgres:5432/fraud_pipeline
DATABASE_URL_SYNC=postgresql://pipeline:pipeline_secret@postgres:5432/fraud_pipeline

# ─── Risk API ───
RISK_API_URL=http://risk-api:8001
RISK_API_TIMEOUT_MS=300
RISK_API_MAX_RETRIES=3

# ─── Observability ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=fraud-pipeline
PROMETHEUS_PORT=8002
LOG_LEVEL=INFO

# ─── Gemini (for RAG copilot) ───
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── API ───
API_HOST=0.0.0.0
API_PORT=8000
